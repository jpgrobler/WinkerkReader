<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Pastoral Calendar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/section_frame"
            android:padding="8dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/primary_blue_dark"
                android:text="@string/pastoral_titel"
                android:textAlignment="center"
                android:textColor="@color/surface_light"
                android:textSize="18sp"
                android:textStyle="bold"
                android:enabled="false"
                android:padding="4dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/tasks_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/stoor"
                android:textColor="#FFFF"
                android:background="@drawable/buttonshape"
                android:layout_marginTop="8dp" />

            <CheckBox
                android:id="@+id/pastoral_calendar_auto_sync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pastoral_calendar_auto_sync_label"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/uitleg_pastoral_calendar_label"
                android:textSize="14sp"
                android:textColor="#666666" />

            <Spinner
                android:id="@+id/pastoral_calendar_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginBottom="8dp" />
        </LinearLayout>

        <!-- Google Tasks -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/section_frame"
            android:padding="8dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:text="@string/tasks_titel"
                android:textStyle="bold"
                android:textSize="16sp"
                android:paddingTop="4dp"
                android:layout_marginBottom="4dp" />

            <RadioGroup
                android:id="@+id/tasks_mode_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/tasks_mode_off"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tasks_af" />
                <RadioButton
                    android:id="@+id/tasks_mode_api"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tasks_outomaties" />
                <RadioButton
                    android:id="@+id/tasks_mode_share"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tasks_deel_elke_keer" />
            </RadioGroup>

            <!-- Apps Script Link (plain text) -->
            <EditText
                android:id="@+id/apps_script_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:hint="@string/google_apps_script_link" />

            <!-- Apps Script Key (password with toggle) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/primary_blue_dark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/apps_script_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/google_apps_script_key"
                    android:textSize="11sp"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tasks_taaklys"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Spinner
                    android:id="@+id/tasks_list_spinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp" />

                <Button
                    android:id="@+id/btn_refresh_lists"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/refresh_lists_btn"
                    android:background="@drawable/buttonshape"
                    android:textColor="#FFFF"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_copy_script"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/copy_script_btn"
                android:background="@drawable/buttonshape"
                android:textColor="#FFFF"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>