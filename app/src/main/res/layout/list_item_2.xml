<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ns1="http://schemas.android.com/apk/res-auto"
    xmlns:ns2="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="2dp">


    <LinearLayout
        android:id="@+id/list_seperatorBlok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:background="@drawable/separator_border"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="horizontal"
        android:padding="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">


        <TextView
            android:id="@+id/list_separator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="7"
            android:text="@string/list_separator_placeholder"
            android:textColor="?attr/colorOnPrimaryFixedVariant"
            android:textSize="14sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/list_separatorwyk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:text=""
            android:textAlignment="viewEnd"
            android:textColor="?attr/colorSecondary"
            android:textSize="14sp"
            android:textStyle="bold" />


    </LinearLayout>


    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:foreground="?attr/selectableItemBackground"
        ns1:cardBackgroundColor="?attr/colorSurface"
        ns1:cardCornerRadius="8dp"
        ns1:cardElevation="2dp">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/item_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">


            <FrameLayout
                android:id="@+id/kontak_frame"
                android:layout_width="50dp"
                android:layout_height="50dp"
                ns1:layout_constraintBottom_toBottomOf="parent"
                ns1:layout_constraintStart_toStartOf="parent"
                ns1:layout_constraintTop_toTopOf="parent">


                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/list_kontak_foto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/kontak"
                    ns1:shapeAppearanceOverlay="@style/CircleImageStyle" />


            </FrameLayout>


            <TextView
                android:id="@+id/list_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:paddingEnd="4dp"
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="?attr/colorPrimary"
                ns1:layout_constraintStart_toEndOf="@id/kontak_frame"
                ns1:layout_constraintTop_toTopOf="parent"
                ns2:text="@string/list_naam" />


            <TextView
                android:id="@+id/list_van"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif-medium"
                android:textAppearance="?android:textAppearanceLarge"
                android:textColor="?attr/colorOnSurface"
                ns1:layout_constraintEnd_toStartOf="@id/list_ouderdom_blok"
                ns1:layout_constraintStart_toEndOf="@id/list_name"
                ns1:layout_constraintTop_toTopOf="@id/list_name"
                ns2:text="@string/list_van" />


            <LinearLayout
                android:id="@+id/list_ouderdom_blok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                ns1:layout_constraintEnd_toEndOf="parent"
                ns1:layout_constraintTop_toTopOf="parent">


                <ImageView
                    android:id="@+id/list_bday"
                    android:layout_width="20dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Verjaarsdag"
                    android:scaleType="centerInside"
                    android:src="@drawable/bday" />


                <TextView
                    android:id="@+id/list_verjaar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="sans-serif-medium"
                    android:paddingEnd="4dp"
                    android:textAppearance="?android:textAppearanceSmall"
                    android:textColor="?attr/colorAccent"
                    ns2:text="@string/list_verjaar" />


                <TextView
                    android:id="@+id/list_ouderdom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="sans-serif-medium"
                    android:textAppearance="?android:textAppearanceSmall"
                    android:textColor="?attr/colorPrimary"
                    ns2:text="0" />


            </LinearLayout>


            <LinearLayout
                android:id="@+id/list_cellBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                ns1:layout_constraintStart_toStartOf="@id/list_name"
                ns1:layout_constraintTop_toBottomOf="@id/list_van">


                <ImageView
                    android:id="@+id/cellimage"
                    android:layout_width="16dp"
                    android:layout_height="24dp"
                    android:contentDescription="Selfoon"
                    android:scaleType="centerInside"
                    android:src="@drawable/cell3"
                    ns1:tint="?attr/colorOnSurface" />


                <TextView
                    android:id="@+id/list_cellnumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="sans-serif"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="?attr/colorPrimary"
                    ns2:text="@string/list_selfoon" />


            </LinearLayout>


            <LinearLayout
                android:id="@+id/list_telBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                ns1:layout_constraintStart_toStartOf="@id/list_name"
                ns1:layout_constraintTop_toBottomOf="@id/list_cellBlock">


                <ImageView
                    android:id="@+id/list_telefoonicon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Landlyn"
                    android:scaleType="centerInside"
                    android:src="@drawable/oldphone"
                    ns1:tint="?attr/colorOnSurface" />


                <TextView
                    android:id="@+id/list_landlyn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="sans-serif"
                    android:paddingStart="4dp"
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="?attr/colorOnSurface"
                    ns2:text="@string/list_telefoon" />


            </LinearLayout>


            <LinearLayout
                android:id="@+id/list_huwelikblok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                ns1:layout_constraintBottom_toBottomOf="@id/list_cellBlock"
                ns1:layout_constraintEnd_toEndOf="parent"
                ns1:layout_constraintTop_toTopOf="@id/list_cellBlock">


                <ImageView
                    android:id="@+id/list_ring"
                    android:layout_width="20dp"
                    android:layout_height="18dp"
                    android:contentDescription="Huwelik"
                    android:src="@drawable/married" />


                <TextView
                    android:id="@+id/list_huwelik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textAppearance="?android:textAppearanceSmall"
                    android:textColor="?attr/colorOnSurface"
                    ns2:text="0" />


            </LinearLayout>


            <LinearLayout
                android:id="@+id/list_wykblok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                ns1:layout_constraintBottom_toBottomOf="@id/list_telBlock"
                ns1:layout_constraintEnd_toEndOf="parent"
                ns1:layout_constraintTop_toTopOf="@id/list_telBlock">


                <ImageView
                    android:id="@+id/list_bediening"
                    android:layout_width="20dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Bediening"
                    android:src="@drawable/ic_bediening" />


                <ImageView
                    android:id="@+id/list_whatsapp"
                    android:layout_width="20dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Whatsapp"
                    android:src="@drawable/whatsapp" />


                <ImageView
                    android:id="@+id/list_epos"
                    android:layout_width="20dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="E-pos"
                    android:src="@drawable/email2"
                    ns1:tint="?attr/colorOnSurface" />


                <TextView
                    android:id="@+id/list_wyk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif"
                    android:textAppearance="?android:textAppearanceSmallInverse"
                    android:textColor="?attr/colorOnTertiary" />


            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </com.google.android.material.card.MaterialCardView>


</LinearLayout>
