<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="2dp">

    <!-- Separator header – now outside the card -->
    <LinearLayout
        android:id="@+id/list_seperatorBlok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:orientation="horizontal"
        android:padding="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/list_separator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="7"
            android:text="@string/list_separator_placeholder"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/list_separatorwyk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:text=""
            android:textAlignment="viewEnd"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Material Card for the member row -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="?attr/colorSurface">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/item_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <!-- Photo frame -->
            <FrameLayout
                android:id="@+id/kontak_frame"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/list_kontak_foto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/kontak"
                    app:shapeAppearanceOverlay="@style/CircleImageStyle" />
            </FrameLayout>

            <!-- Name and Surname -->
            <TextView
                android:id="@+id/list_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="?attr/colorPrimary"
                android:layout_marginStart="8dp"
                android:paddingEnd="4dp"
                app:layout_constraintStart_toEndOf="@id/kontak_frame"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="@string/list_naam" />

            <TextView
                android:id="@+id/list_van"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textAppearance="?android:textAppearanceLarge"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintStart_toEndOf="@id/list_name"
                app:layout_constraintTop_toTopOf="@id/list_name"
                app:layout_constraintEnd_toStartOf="@id/list_ouderdom_blok"
                tools:text="@string/list_van" />

            <!-- Birthday / Age block -->
            <LinearLayout
                android:id="@+id/list_ouderdom_blok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/list_bday"
                    android:layout_width="20dp"
                    android:layout_height="24dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/bday"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/list_verjaar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="sans-serif-medium"
                    android:textAppearance="?android:textAppearanceSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:paddingEnd="4dp"
                    tools:text="@string/list_verjaar" />

                <TextView
                    android:id="@+id/list_ouderdom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="sans-serif-medium"
                    android:textAppearance="?android:textAppearanceSmall"
                    android:textColor="?attr/colorPrimary"
                    tools:text="0" />
            </LinearLayout>

            <!-- Cellphone block -->
            <LinearLayout
                android:id="@+id/list_cellBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="@id/list_name"
                app:layout_constraintTop_toBottomOf="@id/list_name">

                <ImageView
                    android:id="@+id/cellimage"
                    android:layout_width="16dp"
                    android:layout_height="24dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/cell3"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/list_cellnumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="sans-serif"
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="?attr/colorPrimary"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    tools:text="@string/list_selfoon" />
            </LinearLayout>

            <!-- Landline block -->
            <LinearLayout
                android:id="@+id/list_telBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="@id/list_name"
                app:layout_constraintTop_toBottomOf="@id/list_cellBlock">

                <ImageView
                    android:id="@+id/list_telefoonicon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/oldphone"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/list_landlyn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="sans-serif"
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:paddingStart="4dp"
                    tools:text="@string/list_telefoon" />
            </LinearLayout>

            <!-- Wedding block -->
            <LinearLayout
                android:id="@+id/list_huwelikblok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/list_cellBlock"
                app:layout_constraintBottom_toBottomOf="@id/list_cellBlock">

                <ImageView
                    android:id="@+id/list_ring"
                    android:layout_width="20dp"
                    android:layout_height="18dp"
                    android:src="@drawable/married" />

                <TextView
                    android:id="@+id/list_huwelik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textAppearance="?android:textAppearanceSmall"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="0" />
            </LinearLayout>

            <!-- Wyk / Icons block -->
            <LinearLayout
                android:id="@+id/list_wykblok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/list_telBlock"
                app:layout_constraintBottom_toBottomOf="@id/list_telBlock">

                <ImageView
                    android:id="@+id/list_bediening"
                    android:layout_width="20dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_bediening"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:id="@+id/list_whatsapp"
                    android:layout_width="20dp"
                    android:layout_height="18dp"
                    android:src="@drawable/whatsapp"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:id="@+id/list_epos"
                    android:layout_width="20dp"
                    android:layout_height="18dp"
                    android:src="@drawable/email2"
                    android:layout_marginEnd="8dp"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/list_wyk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textAppearance="?android:textAppearanceSmallInverse"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>