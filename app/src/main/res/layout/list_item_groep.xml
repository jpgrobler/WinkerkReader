<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="8dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/GroepNaam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:fontFamily="sans-serif-medium"
            android:text="@string/NuweGroepNaam"
            android:textAppearance="?android:textAppearanceMedium"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/GroepTipe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="16dp"
            android:layout_toRightOf="@+id/GroepNaam"
            android:text="@string/NuweGroepTipe"
            android:textColor="?attr/colorSecondary"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/GroepCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </RelativeLayout>

    <TextView
        android:id="@+id/GroepAdres"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/NuweGroepAdres"
        android:textColor="?attr/colorOnSurface" />

</LinearLayout>