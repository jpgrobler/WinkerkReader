<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ns1="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    ns1:cardBackgroundColor="?attr/colorSurface"
    ns1:cardCornerRadius="8dp"
    ns1:cardElevation="2dp">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">


        <ImageView
            android:id="@+id/iv_member_photo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription=""
            android:focusable="true"
            android:scaleType="centerCrop"
            ns1:layout_constraintStart_toStartOf="parent"
            ns1:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/tv_overdue_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_red"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/bediening_agterstallig"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="10sp"
            android:visibility="gone"
            ns1:layout_constraintEnd_toEndOf="parent"
            ns1:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/tv_member_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            ns1:layout_constraintEnd_toStartOf="@id/tv_anchor_date"
            ns1:layout_constraintStart_toEndOf="@id/iv_member_photo"
            ns1:layout_constraintTop_toTopOf="@id/iv_member_photo" />


        <TextView
            android:id="@+id/tv_anchor_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:alpha="0.6"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            ns1:layout_constraintBottom_toBottomOf="@id/tv_member_name"
            ns1:layout_constraintEnd_toStartOf="@id/tv_overdue_badge"
            ns1:layout_constraintStart_toEndOf="@id/tv_member_name"
            ns1:layout_constraintTop_toTopOf="@id/tv_member_name" />


        <LinearLayout
            android:id="@+id/layout_title_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            ns1:layout_constraintEnd_toEndOf="parent"
            ns1:layout_constraintStart_toEndOf="@id/iv_member_photo"
            ns1:layout_constraintTop_toBottomOf="@id/tv_member_name">


            <TextView
                android:id="@+id/tv_reminder_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurface" />


            <TextView
                android:id="@+id/tv_due_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:alpha="0.6"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />


        </LinearLayout>


        <TextView
            android:id="@+id/tv_context_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:alpha="0.7"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textStyle="italic"
            android:visibility="gone"
            ns1:layout_constraintEnd_toEndOf="parent"
            ns1:layout_constraintStart_toEndOf="@id/iv_member_photo"
            ns1:layout_constraintTop_toBottomOf="@id/layout_title_date" />


        <View
            android:id="@+id/action_divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="?attr/dividerColor"
            ns1:layout_constraintEnd_toEndOf="parent"
            ns1:layout_constraintStart_toStartOf="parent"
            ns1:layout_constraintTop_toBottomOf="@id/tv_context_line" />


        <LinearLayout
            android:id="@+id/layout_actions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            ns1:layout_constraintBottom_toBottomOf="parent"
            ns1:layout_constraintEnd_toEndOf="parent"
            ns1:layout_constraintStart_toStartOf="parent"
            ns1:layout_constraintTop_toBottomOf="@id/action_divider">


            <ImageButton
                android:id="@+id/btn_bel"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/herinnering_bel"
                android:src="@android:drawable/ic_menu_call"
                ns1:tint="?attr/colorOnSurfaceVariant" />


            <ImageButton
                android:id="@+id/btn_whatsapp"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/herinnering_whatsapp"
                android:src="@drawable/whatsapps" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_voltooi"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="2"
                android:text="@string/herinnering_voltooi" />


            <ImageButton
                android:id="@+id/btn_overflow"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/meer_opsies"
                android:src="@android:drawable/ic_menu_more"
                ns1:tint="?attr/colorOnSurfaceVariant" />


        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>


</com.google.android.material.card.MaterialCardView>
