<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_pastoral_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal">

        <!-- Stacked icons: bediening (background) + launcher (top-left) -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:paddingEnd="10dp">

            <!-- Bediening icon (background, larger) – original colours -->
            <ImageView
                android:id="@+id/widget_image_bediening"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:contentDescription="Bediening"
                android:focusable="true"
                android:scaleType="fitXY"
                android:src="@drawable/ic_bediening" />

            <!-- Launcher icon (overlay, top‑left) – original colours -->
            <ImageView
                android:id="@+id/widget_image_launcher"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="top|start"
                android:clickable="true"
                android:contentDescription="WinkerkReader"
                android:focusable="true"
                android:scaleType="fitXY"
                android:src="@drawable/family_roof"
                app:tint="?attr/colorBackgroundFloating" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_pastoral_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:contentDescription="@string/widget_pastoral_title"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/widget_pastoral_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_image2"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:clickable="true"
            android:contentDescription="Bediening"
            android:src="@drawable/updatew" />
    </LinearLayout>

    <!-- ListView – transparent background; rows handle their own -->

    <ListView
        android:id="@+id/widget_pastoral_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:background="@android:color/transparent"
        android:divider="@android:color/transparent" />

    <TextView
        android:id="@+id/widget_pastoral_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/widget_pastoral_empty"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_pastoral_update_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.7"
        android:gravity="center"
        android:text="@string/widget_last_updated"
        android:textSize="11sp" />
</LinearLayout>