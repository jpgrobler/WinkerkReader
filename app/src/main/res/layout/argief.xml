<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingTop="?attr/actionBarSize">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/argief_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="?attr/colorPrimary" />

    <!-- M3 Segmented Button Group replacing RadioGroup -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/argief_sort_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/argief_sort_van"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mainmenu_sort_van" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/argief_sort_datum"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/argief_datum" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/argief_sort_rede"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/argief_rede" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- RecyclerView replacing ListView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/argief_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:background="?attr/colorSurface"
        android:scrollbars="vertical" />

</LinearLayout>