<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- LEFT COLUMN -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="4dp"
                android:paddingRight="4dp">

                <!-- ========== SECTION 1: Existing Icons ========== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/section_frame"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/primary_blue_dark"
                        android:layout_marginBottom="6dp"
                        android:text="@string/uitleg_icons_title"
                        android:textAlignment="center"
                        android:textColor="@color/surface_light"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/uitleg_stoor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/stoor"
                        android:textColor="#FFFF"
                        android:background="@drawable/buttonshape"
                        android:layout_marginBottom="8dp" />

                    <CheckBox
                        android:id="@+id/uitleg_foto"
                        android:text="@string/uitleg_foto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:id="@+id/uitleg_epos"
                        android:text="@string/uitleg_epos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:id="@+id/uitleg_whatsap"
                        android:text="@string/uitleg_whatsapp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:id="@+id/uitleg_verjaarsdag"
                        android:text="@string/uitleg_verjaarsdag"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:id="@+id/uitleg_ouderdom"
                        android:text="@string/filter_ouderdom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:id="@+id/uitleg_Huweliksdag"
                        android:text="@string/uitleg_huweliksdatum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:id="@+id/uitleg_wyk"
                        android:text="@string/list_wyk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:id="@+id/uitleg_selfoon"
                        android:text="@string/list_selfoon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:id="@+id/uitleg_telefoon"
                        android:text="@string/list_telefoon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:id="@+id/widget_Doop_select"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/uitleg_doopdatum" />
                </LinearLayout>

                <!-- ========== SECTION 2: Widget Section ========== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/section_frame"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:background="@color/primary_blue_dark"
                        android:textColor="@color/surface_light"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:text="@string/uitleg_widget_title"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:layout_marginBottom="6dp" />

                    <Button
                        android:id="@+id/save_widget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/buttonshape"
                        android:text="@string/stoor"
                        android:textColor="#FFFF" />

                    <CheckBox
                        android:id="@+id/widget_Belydenis_select"
                        android:text="@string/uitleg_belydenisdatum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:id="@+id/widget_Huwelik_select"
                        android:text="@string/uitleg_huweliksdatum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:id="@+id/widget_Sterf"
                        android:text="@string/uitleg_sterfdatum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- ========== SECTION 3: Pastoral Calendar + Google Tasks ========== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/section_frame"
                    android:layout_marginBottom="8dp">

                    <!-- Pastoral Calendar Selection -->
                    <TextView
                        android:background="@color/primary_blue_dark"
                        android:textColor="@color/surface_light"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:text="@string/pastoral_titel"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:paddingTop="0dp"
                        android:layout_marginBottom="6dp" />
                    <Button
                        android:id="@+id/tasks_save"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/stoor"
                        android:textColor="#FFFF"
                        android:background="@drawable/buttonshape"
                        />
                    <CheckBox
                        android:id="@+id/pastoral_calendar_auto_sync"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/pastoral_calendar_auto_sync_label" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/uitleg_pastoral_calendar_label"
                        android:textSize="14sp"
                        android:textColor="#666666" />

                    <Spinner
                        android:id="@+id/pastoral_calendar_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginBottom="6dp" />

                    <!-- Google Tasks Section -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:text="@string/tasks_titel"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:visibility="gone"
                            android:paddingTop="6dp" />

                        <RadioGroup
                            android:id="@+id/tasks_mode_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:layout_marginBottom="8dp">

                            <RadioButton
                                android:id="@+id/tasks_mode_off"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/tasks_af" />
                            <RadioButton
                                android:id="@+id/tasks_mode_api"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/tasks_outomaties" />
                            <RadioButton
                                android:id="@+id/tasks_mode_api2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/tasks_outomaties" />

                            <RadioButton
                                android:id="@+id/tasks_mode_share"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/tasks_deel_elke_keer" />
                        </RadioGroup>

                        <EditText
                            android:id="@+id/apps_script_link"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:visibility="gone"
                            android:text="Google Apps Script Link"/>
                        <EditText
                            android:id="@+id/apps_script_key"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:visibility="gone"
                            android:text="Google Apps Script Key"/>
                        <Button
                            android:id="@+id/tasks_sign_in"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/tasks_teken_in"
                            android:enabled="false"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tasks_account"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text=""
                            android:visibility="gone"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="8dp" />

                        <Spinner
                            android:id="@+id/tasks_list_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:minHeight="48dp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tasks_warning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tasks_waarskuwing_offline"
                            android:textSize="12sp"
                            android:textColor="#666666"
                            android:visibility="gone"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

            </LinearLayout>   <!-- end left column -->

            <!-- RIGHT COLUMN -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingLeft="4dp">

                <!-- ========== SECTION 4: Funksies (calls & monitors) ========== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/section_frame"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/primary_blue_dark"
                        android:layout_marginBottom="6dp"
                        android:text="@string/uitleg_funksies_title"
                        android:textAlignment="center"
                        android:textColor="@color/surface_light"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/funksoie_Stoor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/stoor"
                        android:textColor="#FFFF"
                        android:background="@drawable/buttonshape"
                        android:layout_marginBottom="8dp" />

                    <CheckBox
                        android:id="@+id/autoStartSwitch"
                        android:text="@string/uitleg_autostart_monitor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:id="@+id/uitleg_Monitor_Oproepe"
                        android:text="@string/uitleg_monitor_oproepe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:id="@+id/uitleg_Log_Oproepe"
                        android:text="@string/uitleg_log_tel_oproepe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:id="@+id/uitleg_Log_VOIP"
                        android:text="@string/uitleg_log_voip_oproepe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/uitleg_calendar_picker"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#666666"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <Spinner
                        android:id="@+id/calendarSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:minHeight="48dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/uitleg_default_layout"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:paddingTop="8dp" />

                    <Spinner
                        android:id="@+id/layoutOpsies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:entries="@array/layoutoptions"
                        android:minHeight="24dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/uitleg_whatsapp_label"
                        android:textSize="16sp"
                        android:paddingTop="8dp" />

                    <CheckBox
                        android:id="@+id/uitleg_w1"
                        android:text="@string/uitleg_whatsapp_method_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:id="@+id/uitleg_w2"
                        android:text="@string/uitleg_whatsapp_method_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <CheckBox
                        android:id="@+id/uitleg_w3"
                        android:text="@string/uitleg_whatsapp_method_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/uitleg_epos_label"
                        android:textSize="16sp"
                        android:paddingTop="8dp" />

                    <CheckBox
                        android:id="@+id/uitleg_html"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/uitleg_html_epos" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/section_frame"
                    android:layout_marginBottom="0dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:text="@string/gemeente_kleur"
                        android:background="@color/primary_blue_dark"
                        android:textColor="@color/surface_light"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:paddingTop="0dp"
                        android:layout_marginBottom="6dp"  />

                    <Button
                        android:id="@+id/saveColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"

                        android:layout_marginBottom="8dp"
                        android:background="@drawable/buttonshape"
                        android:text="@string/stoor"
                        android:textColor="#FFFF" />

                    <TextView
                        android:id="@+id/gem1"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/uitleg_gemeente_1"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:elevation="0dp"
                        android:outlineProvider="none" />

                    <TextView
                        android:id="@+id/gem2"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/uitleg_gemeente_2"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:elevation="0dp"
                        android:outlineProvider="none" />

                    <TextView
                        android:id="@+id/gem3"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/uitleg_gemeente_3"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:elevation="0dp"
                        android:outlineProvider="none" />

                </LinearLayout>

            </LinearLayout>   <!-- end right column -->

        </LinearLayout>
    </LinearLayout>
</ScrollView>