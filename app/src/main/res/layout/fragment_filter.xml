<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:padding="16dp"
    android:maxHeight="800dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="?attr/colorPrimary"
        android:alpha="0.3" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filter Lidmate"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <!-- ============================================================ -->
            <!-- 1. STATUS FILTERS - Material 3 Chip Group                    -->
            <!-- ============================================================ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filter_status_chip_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_status_aktief"
                    style="@style/Widget.WinkerkReader.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aktief"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_status_onaktief"
                    style="@style/Widget.WinkerkReader.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Onaktief" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_status_almal"
                    style="@style/Widget.WinkerkReader.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Almal" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- ============================================================ -->
            <!-- 2. CHECKBOX FILTERS - Material 3                             -->
            <!-- ============================================================ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kenmerke"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginBottom="8dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/filter_selfoon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selfoon"
                    android:textColor="?attr/colorOnSurface"
                    android:minHeight="48dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/filter_landlyn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Landlyn"
                    android:textColor="?attr/colorOnSurface"
                    android:minHeight="48dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/filter_epos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="E-pos"
                    android:textColor="?attr/colorOnSurface"
                    android:minHeight="48dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/filter_gesinshoof"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gesinshoof"
                    android:textColor="?attr/colorOnSurface"
                    android:minHeight="48dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

            </GridLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- ============================================================ -->
            <!-- 3. FILTER WITH AUTOCOMPLETE + SWITCH (Complex filters)       -->
            <!-- ============================================================ -->

            <!-- 3.1 Geslag -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceVariant"
                android:padding="8dp"
                android:layout_marginHorizontal="4dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/filter_geslag_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/geslag_filter_aktief"
                    android:textColor="?attr/colorOnSurface"
                    android:minHeight="48dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="8dp"
                    android:hint="Kies geslag"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="?attr/colorPrimary"
                    app:endIconMode="dropdown_menu">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/filter_geslag_opsies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:inputType="none"
                        android:text="manlik"
                        android:paddingStart="8dp"
                        android:textColor="?attr/colorOnSurface" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- 3.2 Huwelikstatus -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceVariant"
                android:padding="8dp"
                android:layout_marginHorizontal="4dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/filter_huwelikstatus_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/huwelikstatus_filter_aktief"
                    android:textColor="?attr/colorOnSurface"
                    android:minHeight="48dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="8dp"
                    android:hint="Kies huwelikstatus"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="?attr/colorPrimary"
                    app:endIconMode="dropdown_menu">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/filter_huwelikstatus_opsies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:inputType="none"
                        android:text="@string/getroud"
                        android:paddingStart="8dp"
                        android:textColor="?attr/colorOnSurface" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- 3.3 Lidmaatskap -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceVariant"
                android:padding="8dp"
                android:layout_marginHorizontal="4dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/filter_lidmaatskap_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lidmaatskap_filter_aktief"
                    android:textColor="?attr/colorOnSurface"
                    android:minHeight="48dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="8dp"
                    android:hint="@string/kies_lidmaatskap"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="?attr/colorPrimary"
                    app:endIconMode="dropdown_menu">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/filter_lidmaatskap_opsies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:inputType="none"
                        android:text="@string/belydend"
                        android:paddingStart="8dp"
                        android:textColor="?attr/colorOnSurface" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- ============================================================ -->
            <!-- 4. TEXT FILTERS (TextInputLayout + AutoComplete + Switch)    -->
            <!-- ============================================================ -->

            <!-- 4.1 Van -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceVariant"
                android:padding="8dp"
                android:layout_marginHorizontal="4dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/filter_van_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/van_filter_aktief"
                    android:textColor="?attr/colorOnSurface"
                    android:minHeight="48dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="8dp"
                    android:hint="Kies operator"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="?attr/colorPrimary"
                    app:endIconMode="dropdown_menu">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/filter_van_opsies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:inputType="none"
                        android:text="@string/gelyk_aan"
                        android:paddingStart="8dp"
                        android:textColor="?attr/colorOnSurface" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="8dp"
                    android:hint="Voer van in"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="?attr/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/filter_van"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:inputType="textCapWords"
                        android:textColor="?attr/colorOnSurface" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- 4.2 Noemnaam -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceVariant"
                android:padding="8dp"
                android:layout_marginHorizontal="4dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/filter_noemnaam_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/noemnaam_filter_aktief"
                    android:textColor="?attr/colorOnSurface"
                    android:minHeight="48dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="8dp"
                    android:hint="@string/kies_operator"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="?attr/colorPrimary"
                    app:endIconMode="dropdown_menu">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/filter_noemnaam_opsies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:inputType="none"
                        android:text="@string/gelyk_aan"
                        android:paddingStart="8dp"
                        android:textColor="?attr/colorOnSurface" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="8dp"
                    android:hint="@string/voer_noemnaam_in"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="?attr/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/filter_noemnaam"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:inputType="textCapWords"
                        android:textColor="?attr/colorOnSurface" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- 4.3 Nooiensvan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceVariant"
                android:padding="8dp"
                android:layout_marginHorizontal="4dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/filter_nooiensvan_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nooiensvan_filter_aktief"
                    android:textColor="?attr/colorOnSurface"
                    android:minHeight="48dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="8dp"
                    android:hint="@string/kies_operator"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="?attr/colorPrimary"
                    app:endIconMode="dropdown_menu">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/filter_nooiensvan_opsies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:inputType="none"
                        android:text="@string/gelyk_aan"
                        android:paddingStart="8dp"
                        android:textColor="?attr/colorOnSurface" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="8dp"
                    android:hint="@string/voer_nooiensvan_in"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="?attr/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/filter_nooiensvan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:inputType="textCapWords"
                        android:textColor="?attr/colorOnSurface" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- 4.4 Wyk -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceVariant"
                android:padding="8dp"
                android:layout_marginHorizontal="4dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/filter_wyk_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wyk_filter_aktief"
                    android:textColor="?attr/colorOnSurface"
                    android:minHeight="48dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="8dp"
                    android:hint="@string/kies_operator"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="?attr/colorPrimary"
                    app:endIconMode="dropdown_menu">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/filter_wyk_opsies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:inputType="none"
                        android:text="@string/gelyk_aan"
                        android:paddingStart="8dp"
                        android:textColor="?attr/colorOnSurface" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="8dp"
                    android:hint="@string/voer_wyk_in"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="?attr/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/filter_wyk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:inputType="textCapWords"
                        android:textColor="?attr/colorOnSurface" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- ============================================================ -->
            <!-- 5. OUDERDOM (Range filter with spinner)                      -->
            <!-- ============================================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceVariant"
                android:padding="8dp"
                android:layout_marginHorizontal="4dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/filter_ouderdom_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ouderdom_filter_aktief"
                    android:textColor="?attr/colorOnSurface"
                    android:minHeight="48dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="8dp"
                    android:hint="@string/kies_vergelyking"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="?attr/colorPrimary"
                    app:endIconMode="dropdown_menu">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/filter_ouderdom_opsies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:inputType="none"
                        android:text="@string/gelyk_aan"
                        android:paddingStart="8dp"
                        android:textColor="?attr/colorOnSurface" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:hint="Van"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="?attr/colorPrimary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/filter_ouderdom1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:inputType="number"
                            android:textColor="?attr/colorOnSurface" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/tot"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginHorizontal="4dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:hint="@string/tot"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="?attr/colorPrimary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/filter_ouderdom2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:inputType="number"
                            android:textColor="?attr/colorOnSurface" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ============================================================ -->
    <!-- 6. ACTION BUTTONS - Material 3                               -->
    <!-- ============================================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:paddingTop="8dp"
        android:background="?attr/colorSurface"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/herstel"
            android:textColor="?attr/colorPrimary"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/kanselleer"
            android:textColor="?attr/colorPrimary"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:text="@string/pas_filter_toe"
            android:textAllCaps="false"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="?attr/colorOnPrimary" />

    </LinearLayout>

</LinearLayout>