<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Funksies -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="?attr/colorPrimary"
                    android:padding="4dp"
                    android:text="@string/uitleg_funksies_title"
                    android:textAlignment="center"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/funksoie_Stoor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp"
                    style="@style/Widget.WinkerkReader.Button.Primary"
                    android:enabled="false"
                    android:text="@string/stoor" />

                <CheckBox
                    android:id="@+id/autoStartSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/uitleg_autostart_monitor"
                    android:textColor="?attr/colorOnSurface" />

                <CheckBox
                    android:id="@+id/uitleg_Monitor_Oproepe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/uitleg_monitor_oproepe"
                    android:textColor="?attr/colorOnSurface" />

                <CheckBox
                    android:id="@+id/uitleg_Log_Oproepe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/uitleg_log_tel_oproepe"
                    android:textColor="?attr/colorOnSurface" />

                <CheckBox
                    android:id="@+id/uitleg_Log_VOIP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/uitleg_log_voip_oproepe"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/uitleg_calendar_picker"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/calendarSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:minHeight="48dp"
                    android:backgroundTint="?attr/colorPrimary" />

                <!-- WhatsApp Methods -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="8dp"
                            android:text="@string/uitleg_whatsapp_label"
                            android:textSize="16sp"
                            android:textColor="?attr/colorOnSurface" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="8dp">
                        <CheckBox
                            android:id="@+id/uitleg_w1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/uitleg_whatsapp_method_1"
                            android:textColor="?attr/colorOnSurface" />

                        <CheckBox
                            android:id="@+id/uitleg_w2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/uitleg_whatsapp_method_2"
                            android:textColor="?attr/colorOnSurface" />

                        <CheckBox
                            android:id="@+id/uitleg_w3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/uitleg_whatsapp_method_3"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Email -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="8dp"
                            android:text="@string/uitleg_epos_label"
                            android:textSize="16sp"
                            android:textColor="?attr/colorOnSurface" />

                        <CheckBox
                            android:id="@+id/uitleg_html"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/uitleg_html_epos"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>