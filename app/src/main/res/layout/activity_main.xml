<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context="za.co.jpsoft.winkerkreader.ui.activities.MainActivity">

    <LinearLayout
        android:id="@+id/main_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorSurface">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:id="@+id/search_item_block"
            android:visibility="gone">

            <TextView
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:textAlignment="center"
                android:textColor="?attr/colorOnSurface"
                android:background="?attr/colorSurfaceVariant"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="0dp"
                android:layout_toStartOf="@+id/main_search_text_close"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:id="@+id/search_text"
                android:text="@string/main_soek"
                android:maxLines="1"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"/>

            <ImageView
                android:id="@+id/main_search_text_close"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:padding="4dp"
                android:contentDescription="@string/close_search_description"
                android:src="@drawable/ic_close2"
                android:visibility="gone" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:id="@+id/main">

            <ProgressBar
                android:id="@+id/indeterminateBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:progressTint="?attr/colorPrimary"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Chip bar – takes remaining space -->
                <HorizontalScrollView
                    android:id="@+id/chip_scroll_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/congregationChipGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipSpacing="4dp"
                            app:singleSelection="false"
                            app:selectionRequired="false" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Count + Sort labels -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/totalCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(0)"
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp" />

                    <TextView
                        android:id="@+id/sortorder"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⇵"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ✅ Removed SwipeRefreshLayout - using RecyclerView directly -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lidmaat_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical"
                android:background="?attr/colorSurface" />

        </LinearLayout>
    </LinearLayout>
</RelativeLayout>