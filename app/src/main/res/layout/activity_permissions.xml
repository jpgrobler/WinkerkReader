<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/colorSurface">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permissions_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:paddingBottom="8dp" />
    <TextView
        android:id="@+id/tvBatteryStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="?attr/selectableItemBackground"
        android:drawableEnd="@drawable/ic_chevron_right"
        android:clickable="true"
        android:focusable="true"
        android:textSize="16sp" />
    <CheckBox
        android:id="@+id/permission_check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vra_uitstaande_permissions_sodra_app_oopmaak"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permissions_intro"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:paddingBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewPermissions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

    <Button
        android:id="@+id/btnRequestAllPermissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/permissions_request_all"
        android:textAllCaps="false"
        android:padding="12dp"
        style="@style/Widget.WinkerkReader.Button.Primary" />

</LinearLayout>