<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ns1="http://schemas.android.com/apk/res-auto"
    xmlns:ns2="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    ns1:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    ns1:cardCornerRadius="12dp"
                    ns1:cardElevation="0dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">


                        <TextView
                            android:id="@+id/datadate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/laai_datum"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp"
                            android:textStyle="bold" />


                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/laai_indeterminateBar"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"
                            ns1:indicatorColor="?attr/colorPrimary"
                            ns1:trackCornerRadius="2dp" />


                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/laai_indeterminateBar2"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"
                            ns1:indicatorColor="?attr/colorPrimary"
                            ns1:trackCornerRadius="2dp" />


                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/laai_indeterminateBar3"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"
                            ns1:indicatorColor="?attr/colorPrimary"
                            ns1:trackCornerRadius="2dp" />


                    </LinearLayout>


                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/laai_local"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    ns1:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    ns1:cardCornerRadius="12dp"
                    ns1:cardElevation="0dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="@string/nuwe_databasis_reeds_op_foon"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="16sp"
                            android:textStyle="bold" />


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">


                            <Button
                                android:id="@+id/laai_laai"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:text="@string/laai_button"
                                ns2:visibility="gone" />


                            <Button
                                android:id="@+id/laai_picker"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/laai_kies_self" />


                        </LinearLayout>


                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/laai_wisuit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="@string/laai_radio"
                            android:textColor="?attr/colorOnSurfaceVariant" />


                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/laai_indeterminateBar5"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:visibility="visible"
                            ns1:indicatorColor="?attr/colorPrimary"
                            ns1:trackCornerRadius="2dp" />


                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:maxHeight="200dp">


                            <RadioGroup
                                android:id="@+id/laai_filelist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />


                        </ScrollView>


                    </LinearLayout>


                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    ns1:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    ns1:cardCornerRadius="12dp"
                    ns1:cardElevation="0dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/dropbox_title"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp"
                            android:textStyle="bold" />


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">


                            <EditText
                                android:id="@+id/db_link"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:autofillHints="Edit Db Link"
                                android:background="@drawable/material_outlined_edittext"
                                android:gravity="start|center_vertical"
                                android:importantForAutofill="no"
                                android:inputType="textUri"
                                android:minHeight="48dp"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:selectAllOnFocus="true"
                                android:text="@string/dbLink"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="14sp" />


                            <Button
                                android:id="@+id/dbLinkButton"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dbLinkButtonText" />


                        </LinearLayout>


                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/laai_indeterminateBar4"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="8dp"
                            android:visibility="visible"
                            ns1:indicatorColor="?attr/colorPrimary"
                            ns1:trackCornerRadius="2dp" />


                    </LinearLayout>


                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    ns1:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    ns1:cardCornerRadius="12dp"
                    ns1:cardElevation="0dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/server_connection_title"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp"
                            android:textStyle="bold" />


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">


                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">


                                <TextView
                                    android:id="@+id/ip_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/laai_ip_van_pc"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="14sp" />


                                <EditText
                                    android:id="@+id/server_ip"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:autofillHints="Edit Server Ip"
                                    android:background="@drawable/material_outlined_edittext"
                                    android:gravity="start|center_vertical"
                                    android:importantForAutofill="no"
                                    android:inputType="phone"
                                    android:minHeight="48dp"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:selectAllOnFocus="true"
                                    android:text="@string/IP"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="18sp" />


                            </LinearLayout>


                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">


                                <Button
                                    android:id="@+id/laai_socket"
                                    style="@style/Widget.Material3.Button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="4dp"
                                    android:text="@string/laai_wifi" />


                                <Button
                                    android:id="@+id/laai_USB"
                                    style="@style/Widget.Material3.Button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/laai_usb" />


                            </LinearLayout>


                        </LinearLayout>


                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/laai_indeterminateBar10"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="8dp"
                            android:visibility="visible"
                            ns1:indicatorColor="?attr/colorPrimary"
                            ns1:trackCornerRadius="2dp" />


                    </LinearLayout>


                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    ns1:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    ns1:cardCornerRadius="12dp"
                    ns1:cardElevation="0dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/photo_sync_title"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp"
                            android:textStyle="bold" />


                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/force_sync_check"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/laai_force_sync_all_photos"
                            android:textColor="?attr/colorOnSurfaceVariant" />


                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/sync_photos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="@string/laai_sync_photos_after_database"
                            android:textColor="?attr/colorOnSurfaceVariant" />


                        <Button
                            android:id="@+id/start_photo_sync"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/laai_sync_photos_now"
                            android:visibility="visible" />


                    </LinearLayout>


                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    ns1:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    ns1:cardCornerRadius="12dp"
                    ns1:cardElevation="0dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">


                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/laai_status"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:visibility="visible"
                            ns1:indicatorColor="?attr/colorPrimary"
                            ns1:trackCornerRadius="2dp" />


                        <TextView
                            android:id="@+id/laai_boodskap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAlignment="center"
                            android:textColor="?attr/colorSecondary"
                            android:textSize="18sp" />


                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/photo_sync_progress"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"
                            ns1:indicatorColor="?attr/colorPrimary"
                            ns1:trackCornerRadius="2dp" />


                        <TextView
                            android:id="@+id/photo_sync_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/laai_syncing_photos"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp"
                            android:visibility="gone" />


                    </LinearLayout>


                </com.google.android.material.card.MaterialCardView>


            </LinearLayout>


        </ScrollView>


    </LinearLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>
