<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Progress bars -->
            <ProgressBar
                android:id="@+id/laai_indeterminateBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusedByDefault="true"
                android:progressTint="?attr/colorPrimary"
                android:visibility="visible" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/laai_titel"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone" />

            <TextView
                android:id="@+id/datadate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/laai_datum"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <ProgressBar
                android:id="@+id/laai_indeterminateBar2"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusedByDefault="true"
                android:progressTint="?attr/colorPrimary"
                android:visibility="visible" />

            <ProgressBar
                android:id="@+id/laai_indeterminateBar3"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusedByDefault="true"
                android:progressTint="?attr/colorPrimary"
                android:visibility="gone" />

            <!-- Local file selection -->
            <LinearLayout
                android:id="@+id/laai_local"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <Button
                        android:id="@+id/laai_laai"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        style="@style/Widget.WinkerkReader.Button.Primary"
                        android:layout_marginRight="5dp"
                        android:text="@string/laai_button"
                        tools:visibility="gone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nuwe_databasis_reeds_op_foon"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginBottom="20dp"
                        android:textSize="20sp" />

                    <RadioButton
                        android:id="@+id/laai_wisuit"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentStart="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/laai_radio"
                        android:textColor="?attr/colorOnSurface" />

                    <Button
                        android:id="@+id/laai_picker"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        style="@style/Widget.WinkerkReader.Button.Primary"
                        android:text="@string/laai_kies_self" />

                </RelativeLayout>

                <ProgressBar
                    android:id="@+id/laai_indeterminateBar5"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusedByDefault="true"
                    android:progressTint="?attr/colorPrimary"
                    android:visibility="visible" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioGroup
                        android:id="@+id/laai_filelist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </ScrollView>
            </LinearLayout>

            <!-- Dropbox link -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp">

                <EditText
                    android:id="@+id/db_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/dbLinkButton"
                    android:selectAllOnFocus="true"
                    android:text="@string/dbLink"
                    android:textSize="15sp"
                    android:textColor="?attr/colorOnSurface"
                    android:backgroundTint="?attr/colorPrimary" />

                <Button
                    android:id="@+id/dbLinkButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    style="@style/Widget.WinkerkReader.Button.Primary"
                    android:text="@string/dbLinkButtonText" />

            </RelativeLayout>

            <ProgressBar
                android:id="@+id/laai_indeterminateBar4"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusedByDefault="true"
                android:progressTint="?attr/colorPrimary"
                android:visibility="visible" />

            <!-- Server IP + WiFi/USB buttons -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_centerInParent="true"
                    android:layout_alignParentStart="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/ip_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/laai_ip_van_pc"
                        android:textAlignment="center"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="20sp" />

                    <EditText
                        android:layout_marginLeft="50dp"
                        android:id="@+id/server_ip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:selectAllOnFocus="true"
                        android:text="@string/IP"
                        android:textSize="25sp"
                        android:textColor="?attr/colorOnSurface"
                        android:backgroundTint="?attr/colorPrimary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/laai_socket"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Widget.WinkerkReader.Button.Primary"
                        android:layout_marginBottom="5dp"
                        android:text="@string/laai_wifi" />

                    <Button
                        android:id="@+id/laai_USB"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Widget.WinkerkReader.Button.Primary"
                        android:text="@string/laai_usb" />

                </LinearLayout>
            </RelativeLayout>

            <ProgressBar
                android:id="@+id/laai_indeterminateBar10"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusedByDefault="true"
                android:progressTint="?attr/colorPrimary"
                android:visibility="visible" />

            <!-- Photo sync options -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp">

                <CheckBox
                    android:layout_alignParentStart="true"
                    android:id="@+id/force_sync_check"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/laai_force_sync_all_photos"
                    android:textColor="?attr/colorOnSurface" />

                <CheckBox
                    android:layout_alignParentStart="true"
                    android:layout_below="@id/force_sync_check"
                    android:id="@+id/sync_photos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/laai_sync_photos_after_database"
                    android:textColor="?attr/colorOnSurface" />

                <Button
                    android:layout_centerInParent="true"
                    android:layout_alignParentEnd="true"
                    android:id="@+id/start_photo_sync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.WinkerkReader.Button.Primary"
                    android:text="@string/laai_sync_photos_now"
                    android:visibility="visible" />
            </RelativeLayout>

            <!-- Status -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ProgressBar
                    android:id="@+id/laai_status"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusedByDefault="true"
                    android:progressTint="?attr/colorPrimary"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/laai_boodskap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:textColor="?attr/colorSecondary"
                    android:textSize="30sp" />

                <ProgressBar
                    android:id="@+id/photo_sync_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="?attr/colorPrimary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/photo_sync_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:text="@string/laai_syncing_photos"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>