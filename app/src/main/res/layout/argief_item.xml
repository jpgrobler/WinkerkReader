<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/argief_itemmain"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="4dp"
    android:background="?attr/colorSurface">

    <!-- Separator -->
    <TextView
        android:id="@+id/argief_list_separator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:padding="3dp"
        android:text="@string/argief_separator_placeholder"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Content -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/argief_main"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- Top row: Surname + Date of Birth -->
        <RelativeLayout
            android:id="@+id/topRow"
            android:layout_alignParentTop="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/argief_van"
                tools:text="@string/argief_van"
                android:ellipsize="none"
                android:singleLine="false"
                android:scrollHorizontally="false"
                android:layout_centerVertical="true"
                android:paddingEnd="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_alignParentEnd="true"
                android:id="@+id/argief_geboortedatum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:fontFamily="sans-serif-medium"
                android:paddingEnd="8dp"
                android:textAppearance="?android:textAppearanceSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="@string/argief_geboorte" />
        </RelativeLayout>

        <!-- Middle row: Name -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/topRow"
            android:id="@+id/middleRow">

            <TextView
                android:id="@+id/argief_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif-medium"
                android:paddingEnd="8dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textColor="?attr/colorPrimary"
                tools:text="@string/argief_naam" />
        </RelativeLayout>

        <!-- Bottom row: Reason + Departure date + Destination -->
        <RelativeLayout
            android:id="@+id/bottomRow"
            android:layout_below="@+id/middleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/argief_rede"
                tools:text="@string/argief_rede"
                android:paddingEnd="4dp"
                android:paddingStart="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textAppearance="?android:textAppearanceSmall"
                android:layout_gravity="center_vertical"
                android:layout_alignParentStart="true"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/argief_vertrekdatum"
                tools:text="@string/argief_vertrek"
                android:layout_gravity="center_vertical"
                android:paddingStart="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:layout_toEndOf="@+id/argief_rede"
                android:textAppearance="?android:textAppearanceSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_alignParentEnd="true"
                android:layout_gravity="bottom|end"
                android:id="@+id/argief_bestemming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:paddingStart="4dp"
                android:textAppearance="?android:textAppearanceSmall"
                android:textColor="?attr/colorSecondary"
                tools:text="@string/argief_bestemming" />
        </RelativeLayout>

    </RelativeLayout>
</LinearLayout>