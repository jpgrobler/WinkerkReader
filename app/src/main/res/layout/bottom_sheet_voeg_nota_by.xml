<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout: bottom_sheet_voeg_nota_by.xml
    Binding class: BottomSheetVoegNotaByBinding
    Used by: VoegNotaByBottomSheet
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contentContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Drag handle ─────────────────────────────────────────────────── -->
        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_badge_red"
            android:alpha="0.3" />

        <!-- ── Title ───────────────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/tvNotaSheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nota_titel"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginBottom="4dp"/>

        <!-- ── Member name ─────────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/tvNotaMemberName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            tools:text="Jan van der Berg"/>

        <!-- ── Category chips ──────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nota_kategorie"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:layout_marginBottom="8dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="false"
                app:selectionRequired="true"/>

        </HorizontalScrollView>

        <!-- ── Note date ───────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nota_datum"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotaDatum"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:drawableStart="@drawable/kalenders"
            android:drawablePadding="8dp"
            tools:text="25 Jun 2026"/>

        <!-- ── Note text ───────────────────────────────────────────────────── -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/nota_teks_wenk"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNotaTeks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4"
                android:maxLines="8"
                android:gravity="top|start"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Confidential toggle ─────────────────────────────────────────── -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchVertroulik"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nota_vertroulik"
            android:layout_marginBottom="12dp"/>

        <!-- ── Also set reminder ───────────────────────────────────────────── -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkStelHerinnering"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nota_stel_ook_herinnering"
            android:layout_marginBottom="20dp"/>

        <!-- ── Action buttons ──────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKanselleer"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kanselleer"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStoorNota"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="@string/stoor"/>

        </LinearLayout>
        <ProgressBar
            android:id="@+id/saveProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

</androidx.core.widget.NestedScrollView>