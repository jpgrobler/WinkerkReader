<?xml version="1.0" encoding="utf-8"?>
<!--
    layout_bediening_seksie.xml
    Sluit in LidmaatDetailActivity se hoof-layout in met:
        <include layout="@layout/layout_bediening_seksie" />
    OF kopieer die inhoud direk in jou bestaande detail-layout.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp">

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!-- HERINNERINGE AFDELING                                               -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <!-- Header ry: titel + telling + nuut-knop -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvHerinneringSeksieHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔔 Herinneringe"
            android:textAppearance="?attr/textAppearanceTitleSmall"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNuweHerinnering"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Nuut"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- Herinneringe lys (max 3, dan "Wys meer") -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHerinneringe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        tools:itemCount="2"
        tools:listitem="@layout/item_pending_reminder_mini"/>

    <!-- "Wys meer" voetknop — sigbaar as >3 herinneringe -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWysAlHerinneringe"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="Wys meer…"
        android:textSize="12sp"
        tools:visibility="visible"/>

    <!-- Leë staat -->
    <TextView
        android:id="@+id/tvGeenHerinneringe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="Geen aktiewe herinneringe nie"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textStyle="italic"
        android:paddingVertical="4dp"/>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!-- NOTAS AFDELING (toegevou by verstek)                                -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <!-- Inklapbare header: tik om toe/oop te maak -->
    <LinearLayout
        android:id="@+id/layoutNotasHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/tvNotaSeksieHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📝 Bedieningsnotas"
            android:textAppearance="?attr/textAppearanceTitleSmall"/>

        <!-- Telling badge -->
        <TextView
            android:id="@+id/tvNotaCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="(4)"
            tools:visibility="visible"/>

        <!-- Nuut-knop -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNuweNota"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Nuut"
            android:textSize="12sp"/>

        <!-- Uitvou-pyltjie -->
        <ImageView
            android:id="@+id/ivNotasChevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_down"
            android:contentDescription="Uitvou"
            app:tint="?attr/colorOnSurfaceVariant"/>

    </LinearLayout>

    <!-- Inklapbare inhoud -->
    <LinearLayout
        android:id="@+id/layoutNotasInhoud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:itemCount="2"
            tools:listitem="@layout/item_pastoral_note"/>

        <!-- "Wys ouer notas" voetknop -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWysAlNotas"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Wys ouer notas…"
            android:textSize="12sp"
            tools:visibility="visible"/>

        <!-- Leë staat -->
        <TextView
            android:id="@+id/tvGeenNotas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Geen bedieningsnotas nie"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textStyle="italic"
            android:paddingVertical="4dp"/>

    </LinearLayout>

    <!-- Onderste spasiëring -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="24dp"/>

</LinearLayout>