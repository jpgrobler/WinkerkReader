<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingHorizontal="16dp">

    <!-- HERINNERINGE AFDELING -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHerinneringSeksieHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/herinneringe"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNuweHerinnering"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nuut"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- RecyclerView for reminders -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHerinneringe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        tools:itemCount="2"
        tools:listitem="@layout/item_pending_reminder_mini" />

    <!-- "Wys meer" button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWysAlHerinneringe"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/wys_meer"
        android:textColor="?attr/colorPrimary"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvGeenHerinneringe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="4dp"
        android:text="@string/geen_aktiewe_herinneringe_nie"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textStyle="italic"
        android:visibility="gone" />

    <!-- NOTAS AFDELING (collapsible) -->
    <LinearLayout
        android:id="@+id/layoutNotasHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/tvNotaSeksieHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bedieningsnotas"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvNotaCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="(4)"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNuweNota"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nuut"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/ivNotasChevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/uitvou"
            android:src="@drawable/ic_chevron_down"
            app:tint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <!-- Collapsible content -->
    <LinearLayout
        android:id="@+id/layoutNotasInhoud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:itemCount="2"
            tools:listitem="@layout/item_pastoral_note" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWysAlNotas"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wys_ouer_notas"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvGeenNotas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp"
            android:text="@string/geen_bedieningsnotas_nie"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textStyle="italic"
            android:visibility="gone" />

    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="24dp" />

</LinearLayout>