<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- Fixed: Icons title + Save (never scrolls away) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_marginBottom="0dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="?attr/colorPrimary"
                android:padding="4dp"
                android:text="@string/uitleg_icons_title"
                android:textAlignment="center"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/uitleg_stoor"
                style="@style/Widget.WinkerkReader.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:enabled="false"
                android:text="@string/stoor"
                android:textColor="?attr/colorOnPrimary" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp"
        android:paddingTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Icons checkboxes -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- 2-column grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="4dp">

                            <CheckBox
                                android:id="@+id/uitleg_foto"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/uitleg_foto"
                                android:textColor="?attr/colorOnSurface" />

                            <CheckBox
                                android:id="@+id/uitleg_epos"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/uitleg_epos"
                                android:textColor="?attr/colorOnSurface" />

                            <CheckBox
                                android:id="@+id/uitleg_whatsap"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/uitleg_whatsapp"
                                android:textColor="?attr/colorOnSurface" />

                            <CheckBox
                                android:id="@+id/uitleg_verjaarsdag"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/uitleg_verjaarsdag"
                                android:textColor="?attr/colorOnSurface" />

                            <CheckBox
                                android:id="@+id/uitleg_ouderdom"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/filter_ouderdom"
                                android:textColor="?attr/colorOnSurface" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="4dp">

                            <CheckBox
                                android:id="@+id/uitleg_Huweliksdag"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/uitleg_huweliksdatum"
                                android:textColor="?attr/colorOnSurface" />

                            <CheckBox
                                android:id="@+id/uitleg_wyk"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/list_wyk"
                                android:textColor="?attr/colorOnSurface" />

                            <CheckBox
                                android:id="@+id/uitleg_selfoon"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/list_selfoon"
                                android:textColor="?attr/colorOnSurface" />

                            <CheckBox
                                android:id="@+id/uitleg_telefoon"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/list_telefoon"
                                android:textColor="?attr/colorOnSurface" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Default Layout -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:text="@string/uitleg_default_layout"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/layoutOpsies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:backgroundTint="?attr/colorPrimary"
                        android:entries="@array/layoutoptions"
                        android:minHeight="24dp" />

                    <!-- Gemeente aanduiding nested card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="8dp"
                                android:text="Gemeente aanduiding"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <CheckBox
                                android:id="@+id/congregation_indicator_switch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Gebruik ring om foto (i.p.v. agtergrondkleur)"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="32dp"
                                android:text="Wanneer aan, word die gemeente-kleur as &#39;n ring om die kontakfoto gewys, en die agtergrond bly neutraal."
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Theme Selection -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:text="Tema (Dark / Light)"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/theme_mode_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/theme_mode_system"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Stelsel"
                            android:textColor="?attr/colorOnSurface" />

                        <RadioButton
                            android:id="@+id/theme_mode_light"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Lig"
                            android:textColor="?attr/colorOnSurface" />

                        <RadioButton
                            android:id="@+id/theme_mode_dark"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Donker"
                            android:textColor="?attr/colorOnSurface" />

                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Colors Section (saveColor stays with its section) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="?attr/colorPrimary"
                        android:padding="4dp"
                        android:text="@string/gemeente_kleur"
                        android:textAlignment="center"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/saveColor"
                        style="@style/Widget.WinkerkReader.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="8dp"
                        android:enabled="false"
                        android:text="@string/stoor"
                        android:textColor="?attr/colorOnPrimary" />

                    <TextView
                        android:id="@+id/gem1"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:background="?attr/colorSurfaceVariant"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/uitleg_gemeente_1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/gem2"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:background="?attr/colorSurfaceVariant"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/uitleg_gemeente_2"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/gem3"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:background="?attr/colorSurfaceVariant"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/uitleg_gemeente_3"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/inactive_color_preview"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:background="?attr/colorSurfaceVariant"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Onaktief"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>