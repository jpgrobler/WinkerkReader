<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/itemmain"
    android:orientation="vertical"
    android:padding="4dp"
    android:background="?attr/colorSurface">

    <!-- Separator header -->
    <LinearLayout
        android:id="@+id/list_seperatorBlok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/list_separator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="7"
            android:text="@string/list_separator_placeholder"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="3dp" />

        <TextView
            android:id="@+id/list_separatorwyk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:text=""
            android:textAlignment="viewEnd"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="3dp" />
    </LinearLayout>

    <!-- Main row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- Photo frame using ShapeableImageView -->
        <FrameLayout
            android:id="@+id/kontak_frame"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="8dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/list_kontak_foto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/kontak"
                app:shapeAppearanceOverlay="@style/CircleImageStyle" />

        </FrameLayout>

        <!-- Text content -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/main">

            <!-- Top row: name + surname + age/birthday -->
            <RelativeLayout
                android:id="@+id/topRow"
                android:layout_alignParentTop="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/list_name"
                    tools:text="@string/list_naam"
                    android:paddingEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-medium"
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/list_van"
                    tools:text="@string/list_van"
                    android:ellipsize="none"
                    android:singleLine="false"
                    android:scrollHorizontally="false"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textAppearance="?android:textAppearanceLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_toStartOf="@+id/list_ouderdom_blok"
                    android:layout_toEndOf="@+id/list_name" />

                <LinearLayout
                    android:id="@+id/list_ouderdom_blok"
                    android:orientation="horizontal"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_toStartOf="@+id/list_verjaar"
                        android:id="@+id/list_bday"
                        android:layout_centerVertical="true"
                        android:src="@drawable/bday"
                        android:layout_width="20dp"
                        android:layout_height="24dp"
                        android:scaleType="centerInside"
                        android:layout_marginEnd="4dp"
                         />

                    <TextView
                        android:id="@+id/list_verjaar"
                        tools:text="@string/list_verjaar"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/list_ouderdom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAppearance="?android:textAppearanceSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/list_ouderdom"
                        tools:text="0"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textAppearance="?android:textAppearanceSmall"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Bottom row: contact info + icons -->
            <RelativeLayout
                android:id="@+id/bottomRow"
                android:layout_below="@+id/topRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Cellphone -->
                <LinearLayout
                    android:id="@+id/list_cellBlock"
                    android:layout_alignParentStart="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/cellimage"
                        android:layout_width="16dp"
                        android:layout_height="24dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/cell3"
                        app:tint="?attr/colorOnSurface" />
                    <TextView
                        android:id="@+id/list_cellnumber"
                        tools:text="@string/list_selfoon"
                        android:paddingEnd="4dp"
                        android:paddingStart="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textAppearance="?android:textAppearanceMedium"
                        android:layout_gravity="center_vertical"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <!-- Landline -->
                <LinearLayout
                    android:layout_below="@id/list_cellBlock"
                    android:id="@+id/list_telBlock"
                    android:layout_alignParentStart="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:scaleType="centerInside"
                        android:id="@+id/list_telefoonicon"
                        android:src="@drawable/oldphone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:tint="?attr/colorOnSurface" />
                    <TextView
                        android:id="@+id/list_landlyn"
                        tools:text="@string/list_telefoon"
                        android:layout_gravity="center_vertical"
                        android:paddingStart="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textAppearance="?android:textAppearanceMedium"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <!-- Wedding info -->
                <LinearLayout
                    android:id="@+id/list_huwelikblok"
                    android:orientation="horizontal"
                    android:layout_alignParentEnd="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/list_ring"
                        android:layout_width="20dp"
                        android:layout_height="18dp"
                        android:src="@drawable/married"
                         />
                    <TextView
                        android:id="@+id/list_huwelik"
                        tools:text="0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textAppearance="?android:textAppearanceSmall"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <!-- Icons row (simplified) -->
                <LinearLayout
                    android:id="@+id/list_wykblok"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_alignParentEnd="true"
                    android:layout_below="@id/list_huwelikblok">

                    <ImageView
                        android:id="@+id/list_bediening"
                        android:layout_width="20dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_bediening"
                        android:layout_marginEnd="8dp"
                        android:visibility="visible" />

                    <ImageView
                        android:id="@+id/list_whatsapp"
                        android:layout_width="20dp"
                        android:layout_height="18dp"
                        android:src="@drawable/whatsapp"
                        android:layout_marginEnd="8dp"
                         />

                    <ImageView
                        android:id="@+id/list_epos"
                        android:layout_width="20dp"
                        android:layout_height="18dp"
                        android:src="@drawable/email2"
                        android:layout_marginEnd="8dp"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/list_wyk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textAppearance="?android:textAppearanceSmallInverse"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>