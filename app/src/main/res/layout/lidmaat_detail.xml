<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ns1="http://schemas.android.com/apk/res-auto"
    xmlns:ns2="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/detail_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp">


        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/detail_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:paddingTop="10dp"
            ns1:menu="@menu/menu_lidmaat_detail"
            ns1:navigationIcon="@drawable/ic_close"
            ns1:navigationIconTint="?attr/colorOnSurface"
            ns1:title="" />


        <ProgressBar
            android:id="@+id/detail_indeterminateBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:progressTint="?attr/colorPrimary"
            android:visibility="visible" />


    </com.google.android.material.appbar.AppBarLayout>


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        ns1:layout_behavior="@string/appbar_scrolling_view_behavior">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <View
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="?attr/colorPrimaryContainer" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">


                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">


                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/detail_kontak_foto"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:elevation="4dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/kontak"
                            android:tag="default"
                            ns1:shapeAppearanceOverlay="@style/CircleImageStyle" />


                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom|end"
                            android:contentDescription="WinkerkReader"
                            android:elevation="4dp"
                            android:importantForAccessibility="no"
                            android:padding="5dp"
                            android:src="@drawable/family_roof"
                            ns1:tint="?attr/colorPrimary" />


                    </FrameLayout>


                    <TextView
                        android:id="@+id/detail_header_naam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        ns2:text="Pieter Grobler" />


                    <TextView
                        android:id="@+id/detail_gemeentenaam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:maxLines="1"
                        android:text="@string/detail_gemeente"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />


                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        ns1:chipSpacingHorizontal="6dp"
                        ns1:singleLine="true">


                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_ouderdom"
                            style="@style/Widget.WinkerkReader.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            ns1:chipIcon="@drawable/bday"
                            ns2:text="42 jaar" />


                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_wyk"
                            style="@style/Widget.WinkerkReader.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            ns2:text="Wyk 4" />


                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_lidmaatstatus"
                            style="@style/Widget.WinkerkReader.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            ns2:text="Belydend" />


                    </com.google.android.material.chip.ChipGroup>


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:orientation="horizontal">


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/quick_action_bel"
                            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@string/herinnering_bel"
                            ns1:icon="@drawable/cell3"
                            ns1:iconGravity="textStart"
                            ns1:iconPadding="0dp"
                            ns1:iconSize="24dp"
                            ns1:iconTint="@null" />


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/quick_action_whatsapp"
                            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@string/herinnering_whatsapp"
                            ns1:icon="@drawable/whatsapp"
                            ns1:iconGravity="textStart"
                            ns1:iconPadding="0dp"
                            ns1:iconSize="24dp"
                            ns1:iconTint="@null" />


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/quick_action_sms"
                            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@string/lidmaatlistmenu_stuur_sms"
                            ns1:icon="@drawable/sms2"
                            ns1:iconGravity="textStart"
                            ns1:iconPadding="0dp"
                            ns1:iconSize="24dp"
                            ns1:iconTint="@null" />


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/quick_action_epos"
                            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@string/detail_epos"
                            ns1:icon="@drawable/email2"
                            ns1:iconGravity="textStart"
                            ns1:iconPadding="0dp"
                            ns1:iconSize="24dp"
                            ns1:iconTint="@null" />


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/quick_action_kalender"
                            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/lidmaatlistmenu_nota"
                            ns1:icon="@drawable/kalender"
                            ns1:iconGravity="textStart"
                            ns1:iconPadding="0dp"
                            ns1:iconSize="24dp"
                            ns1:iconTint="@null" />


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/quick_action_herinnering"
                            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@string/quick_action_herinnering"
                            ns1:icon="@drawable/ic_bediening"
                            ns1:iconGravity="textStart"
                            ns1:iconPadding="0dp"
                            ns1:iconSize="24dp"
                            ns1:iconTint="@null" />


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/quick_action_notas"
                            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/quick_action_notas"
                            ns1:icon="@drawable/ic_note"
                            ns1:iconGravity="textStart"
                            ns1:iconPadding="0dp"
                            ns1:iconSize="24dp"
                            ns1:iconTint="@null" />


                    </LinearLayout>


                </LinearLayout>


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonWysig"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="@string/detail_wysig"
                    ns1:icon="@android:drawable/ic_menu_edit"
                    ns1:iconGravity="textStart"
                    ns1:iconPadding="0dp" />


            </FrameLayout>


            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.WinkerkReader.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                ns1:cardBackgroundColor="?attr/colorSurfaceContainerLow">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">


                    <TextView
                        style="@style/TextAppearance.WinkerkReader.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/detail_kontak_info"
                        android:textColor="?attr/colorPrimary"
                        ns2:ignore="HardcodedText" />


                    <LinearLayout
                        android:id="@+id/detail_selfoonBlock"
                        style="@style/Widget.WinkerkReader.ListItem"
                        android:orientation="horizontal">


                        <ImageView
                            android:id="@+id/detail_selfoon_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:contentDescription="Selfoon"
                            android:src="@drawable/cell3"
                            ns1:tint="?attr/colorPrimary" />


                        <EditText
                            android:id="@+id/detail_selfoon"
                            style="@style/EditorFieldStyle"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="12dp"
                            android:autofillHints="Edit Selfoon"
                            android:hint="@string/detail_selfoon"
                            android:inputType="phone"
                            ns2:text="082 123 4567" />


                        <ImageView
                            android:id="@+id/detail_whatsapp_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:contentDescription="Whatsapp"
                            android:src="@drawable/whatsapp" />


                        <ImageView
                            android:id="@+id/detail_sms_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="12dp"
                            android:contentDescription="Sms"
                            android:src="@drawable/sms2"
                            ns1:tint="?attr/colorOnSurfaceVariant" />


                    </LinearLayout>


                    <View
                        android:id="@+id/divider_selfoon"
                        style="@style/Widget.WinkerkReader.Divider" />


                    <LinearLayout
                        android:id="@+id/detail_telefoonBlock"
                        style="@style/Widget.WinkerkReader.ListItem"
                        android:orientation="horizontal">


                        <ImageView
                            android:id="@+id/detail_landlyn_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:contentDescription="Landlyn"
                            android:src="@drawable/oldphone"
                            ns1:tint="?attr/colorPrimary" />


                        <EditText
                            android:id="@+id/detail_telefoon"
                            style="@style/EditorFieldStyle"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="12dp"
                            android:autofillHints="Edit Telefoon"
                            android:hint="@string/detail_landlyn"
                            android:inputType="phone"
                            ns2:text="021 555 1234" />


                    </LinearLayout>


                    <View
                        android:id="@+id/divider_telefoon"
                        style="@style/Widget.WinkerkReader.Divider" />


                    <LinearLayout
                        android:id="@+id/detail_eposBlock"
                        style="@style/Widget.WinkerkReader.ListItem"
                        android:orientation="horizontal">


                        <ImageView
                            android:id="@+id/detail_email_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:contentDescription="E-pos"
                            android:src="@drawable/email2"
                            ns1:tint="?attr/colorPrimary" />


                        <EditText
                            android:id="@+id/detail_epos"
                            style="@style/EditorFieldStyle"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="12dp"
                            android:autofillHints="Edit Epos"
                            android:hint="@string/detail_epos"
                            android:inputType="textEmailAddress"
                            ns2:text="pieter@voorbeeld.co.za" />


                    </LinearLayout>


                    <View
                        android:id="@+id/divider_epos"
                        style="@style/Widget.WinkerkReader.Divider" />


                    <LinearLayout
                        android:id="@+id/detail_straatadresBlock"
                        style="@style/Widget.WinkerkReader.ListItem"
                        android:orientation="horizontal">


                        <ImageView
                            android:id="@+id/detail_straat_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top"
                            android:layout_marginTop="14dp"
                            android:contentDescription="Adres"
                            android:src="@drawable/location"
                            ns1:tint="?attr/colorPrimary" />


                        <EditText
                            android:id="@+id/detail_straatadres"
                            style="@style/EditorFieldStyle"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="12dp"
                            android:autofillHints="Edit Straatadres"
                            android:hint="@string/detail_straatadres"
                            android:inputType="textPostalAddress|textMultiLine"
                            ns2:text="Kerkstraat 12, Stellenbosch" />


                    </LinearLayout>


                    <View
                        android:id="@+id/divider_straatadres"
                        style="@style/Widget.WinkerkReader.Divider" />


                    <LinearLayout
                        android:id="@+id/detail_posadresBlock"
                        style="@style/Widget.WinkerkReader.ListItem"
                        android:orientation="horizontal">


                        <Space
                            android:layout_width="24dp"
                            android:layout_height="1dp" />


                        <EditText
                            android:id="@+id/detail_posadres"
                            style="@style/EditorFieldStyle"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="12dp"
                            android:autofillHints="Edit Posadres"
                            android:hint="@string/detail_posadres"
                            android:inputType="textPostalAddress|textMultiLine"
                            ns2:text="Posbus 45, Stellenbosch, 7599" />


                    </LinearLayout>


                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.WinkerkReader.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                ns1:cardBackgroundColor="?attr/colorSurfaceContainerLow">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">


                    <LinearLayout
                        style="@style/Widget.WinkerkReader.ListItem"
                        android:orientation="horizontal">


                        <TextView
                            style="@style/CategoryStyle"
                            android:text="@string/detail_naam" />


                        <EditText
                            android:id="@+id/detail_noemnaam"
                            style="@style/EditorFieldStyle"
                            android:autofillHints="Edit Noemnaam"
                            android:textIsSelectable="true"
                            ns2:text="Pieter" />


                    </LinearLayout>


                    <LinearLayout
                        style="@style/Widget.WinkerkReader.ListItem"
                        android:orientation="horizontal">


                        <TextView
                            style="@style/CategoryStyle"
                            android:text="@string/detail_van" />


                        <EditText
                            android:id="@+id/detail_van"
                            style="@style/EditorFieldStyle"
                            android:autofillHints="Edit Van"
                            android:textIsSelectable="true"
                            ns2:text="Grobler" />


                    </LinearLayout>


                    <LinearLayout
                        style="@style/Widget.WinkerkReader.ListItem"
                        android:orientation="horizontal">


                        <TextView
                            style="@style/CategoryStyle"
                            android:text="@string/detail_vollename" />


                        <EditText
                            android:id="@+id/detail_vollename"
                            style="@style/EditorFieldStyle"
                            android:autofillHints="Edit Vollename"
                            android:textIsSelectable="true"
                            ns2:text="Pieter Jacobus" />


                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/detail_nooiensvanBlock"
                        style="@style/Widget.WinkerkReader.ListItem"
                        android:orientation="horizontal">


                        <TextView
                            style="@style/CategoryStyle"
                            android:text="@string/detail_Nooiensvan" />


                        <EditText
                            android:id="@+id/detail_nooiensvan"
                            style="@style/EditorFieldStyle"
                            android:autofillHints="Edit Nooiensvan"
                            android:textIsSelectable="true" />


                    </LinearLayout>


                    <View style="@style/Widget.WinkerkReader.Divider" />


                    <LinearLayout
                        style="@style/Widget.WinkerkReader.ListItem"
                        android:orientation="horizontal">


                        <TextView
                            style="@style/CategoryStyle"
                            android:text="@string/detail_gebore" />


                        <EditText
                            android:id="@+id/detail_geboortedatum"
                            style="@style/EditorFieldStyle"
                            android:layout_gravity="center_vertical"
                            android:layout_weight="2"
                            android:autofillHints="Edit Geboortedatum"
                            ns2:text="12/04/1978" />


                        <TextView
                            android:id="@+id/detail_jareoud"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            ns2:text="(47)" />


                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp">


                        <Spinner
                            android:id="@+id/geslag"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:backgroundTint="?attr/colorPrimary" />


                        <Spinner
                            android:id="@+id/huwelikstatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:backgroundTint="?attr/colorPrimary" />


                    </LinearLayout>


                    <View style="@style/Widget.WinkerkReader.Divider" />


                    <LinearLayout
                        android:id="@+id/detail_BeroepBlock"
                        style="@style/Widget.WinkerkReader.ListItem"
                        android:orientation="horizontal">


                        <TextView
                            style="@style/CategoryStyle"
                            android:text="@string/detail_beroep" />


                        <EditText
                            android:id="@+id/detail_Beroep"
                            style="@style/EditorFieldStyle"
                            android:autofillHints="Edit Beroep"
                            android:textIsSelectable="true" />


                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/detail_WerkgewerBlock"
                        style="@style/Widget.WinkerkReader.ListItem"
                        android:orientation="horizontal">


                        <TextView
                            style="@style/CategoryStyle"
                            android:text="@string/detail_werkgewer" />


                        <EditText
                            android:id="@+id/detail_Werkgewer"
                            style="@style/EditorFieldStyle"
                            android:autofillHints="Edit Werkgewer"
                            android:textIsSelectable="true" />


                    </LinearLayout>


                    <View style="@style/Widget.WinkerkReader.Divider" />


                    <LinearLayout
                        android:id="@+id/detail_wykBlock"
                        style="@style/Widget.WinkerkReader.ListItem"
                        android:orientation="horizontal">


                        <TextView
                            style="@style/CategoryStyle"
                            android:text="@string/detail_wyk" />


                        <EditText
                            android:id="@+id/detail_wyk"
                            style="@style/EditorFieldStyle"
                            android:autofillHints="Edit Wyk"
                            android:textIsSelectable="true" />


                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/detail_lidmaatstatusBlock"
                        style="@style/Widget.WinkerkReader.ListItem"
                        android:orientation="horizontal">


                        <TextView
                            style="@style/CategoryStyle"
                            android:text="@string/detail_lidmaatskap" />


                        <EditText
                            android:id="@+id/detail_Lidmaatstatus"
                            style="@style/EditorFieldStyle"
                            android:autofillHints="Edit Lidmaatstatus"
                            android:textIsSelectable="true" />


                    </LinearLayout>


                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detail_mylpaleBlock2"
                style="@style/Widget.WinkerkReader.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                ns1:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                ns2:visibility="visible">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">


                    <LinearLayout
                        android:id="@+id/card_mylpale_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_mylpale"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="?attr/colorPrimary" />


                        <ImageView
                            android:id="@+id/card_mylpale_chevron"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Af pyltjie"
                            android:src="@drawable/ic_chevron_down"
                            ns1:tint="?attr/colorOnSurfaceVariant" />


                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/detail_mylpaleBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingBottom="12dp" />


                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detail_gesinBlock"
                style="@style/Widget.WinkerkReader.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                ns1:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                ns2:visibility="visible">


                <LinearLayout
                    android:id="@+id/detail_gesin_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="8dp"
                        android:text="@string/detail_gesin"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorPrimary" />


                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.WinkerkReader.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                ns1:cardBackgroundColor="?attr/colorSurfaceContainerLow">


                <LinearLayout
