<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true"
    app:rippleColor="?attr/colorPrimaryContainer">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ─── Top Row: Caller Info + Close Button ─── -->
        <LinearLayout
            android:id="@+id/oproepfloaterbase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:background="@drawable/float_background_m3"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Icon -->
            <ImageView
                android:id="@+id/floatericon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="?attr/colorPrimaryContainer"
                android:contentDescription="@string/app_name"
                android:padding="4dp"
                android:src="@drawable/ic_launcher_round" />

            <!-- Caller name (hidden when multiple members) -->
            <TextView
                android:id="@+id/oproepnommer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:gravity="center_vertical"
                android:maxLines="8"
                android:text="@string/oproep_titel"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <!-- Close button -->
            <ImageView
                android:id="@+id/close_btn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/close_button_background"
                android:contentDescription="@string/close"
                android:padding="4dp"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- ─── Divider (visible only when actions are shown) ─── -->
        <View
            android:id="@+id/actions_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:visibility="gone" />

        <!-- ─── Member Selection RadioGroup (hidden initially) ─── -->
        <RadioGroup
            android:id="@+id/member_radio_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp"
            android:orientation="vertical"
            android:padding="4dp"
            android:visibility="gone" />

        <!-- ─── Quick Action Buttons Row ─── -->
        <LinearLayout
            android:id="@+id/quick_actions_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="visible">

            <!-- Add Note Button -->
            <LinearLayout
                android:id="@+id/action_note"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:enabled="false"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/nota_icon"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/nota2"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="4dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- Set Reminder Button -->
            <LinearLayout
                android:id="@+id/action_reminder"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:enabled="false"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Bediening"
                    android:src="@drawable/ic_bediening" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Herinner"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="10sp" />

            </LinearLayout>
            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="4dp"
                android:background="?attr/colorOutlineVariant" />

            <LinearLayout
                android:id="@+id/action_search"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/soek_lidmaat"
                    android:scaleType="fitCenter"
                    android:src="@drawable/search" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Soek"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="10sp" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>