<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true"
    app:rippleColor="?attr/colorPrimaryContainer">

    <LinearLayout
        android:id="@+id/oproepfloaterbase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:background="@drawable/float_background_m3"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Icon with Material 3 styling -->
        <ImageView
            android:id="@+id/floatericon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/colorPrimaryContainer"
            android:contentDescription="@string/app_name"
            android:padding="4dp"
            android:src="@drawable/ic_launcher_round" />

        <!-- Primary text -->
        <TextView
            android:id="@+id/oproepnommer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:gravity="center_vertical"
            android:text="@string/oproep_titel"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <!-- Close button using ImageView instead of FAB -->
        <ImageView
            android:id="@+id/close_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/close_button_background"
            android:contentDescription="@string/close"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>