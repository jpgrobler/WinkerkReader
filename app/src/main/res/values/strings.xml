    <!-- Permission Rationale (Afrikaans) -->
    <string name="rationale_phone_title">Toegang tot Foon &amp; Oproeplog</string>
    <string name="rationale_phone_message">WinkerkReader gebruik foonstatus en oproeplog-toestemming om oproeperinligting uit die gemeentedatabasis te wys tydens inkomende oproepe. Sonder hierdie toestemmings sal die oproeperidentifikasie nie werk nie.</string>

    <string name="rationale_contacts_title">Kontaktoegang</string>
    <string name="rationale_contacts_message">WinkerkReader moet jou kontakte lees om WhatsApp-profiele op te spoor. Dit laat jou toe om vinnig WhatsApp-boodskappe aan lede te stuur. Ons verander nooit jou kontakte sonder jou uitdruklike toestemming nie.</string>

    <string name="rationale_sms_title">SMS-toegang</string>
    <string name="rationale_sms_message">WinkerkReader benodig toestemming om verjaarsdag- en geleentheid-SMS\'e aan lede te stuur. Dit word gebruik wanneer jy kies om SMS-groete te stuur. Ons lees nie jou persoonlike SMS\'e nie.</string>

    <string name="rationale_calendar_title">Kalendertoegang</string>
    <string name="rationale_calendar_message">WinkerkReader kan oproepe en pastorale herinnerings na jou kalender log. Dit help jou om interaksies en opvolgaksies by te hou. Jy kan kies watter kalender om te gebruik in die instellings.</string>

    <string name="rationale_notifications_title">Kennisgewings</string>
    <string name="rationale_notifications_message">WinkerkReader gebruik kennisgewings om jou te herinner aan pastorale take, verjaarsdag-SMS-herinnerings en oproepmoniteringstatus. Dit hou jou ingelig selfs wanneer die app op die agtergrond is.</string>

    <string name="rationale_overlay_title">Vertoon oor ander programme</string>
    <string name="rationale_overlay_message">WinkerkReader benodig toestemming om oproeperinligting as \'n swewende oorleg tydens oproepe te wys. Dit is opsioneel, maar bied \'n beter oproeperidentifikasie-ervaring.</string>

    <string name="rationale_exact_alarm_title">Presiese Alarmtoestemming</string>
    <string name="rationale_exact_alarm_message">WinkerkReader gebruik presiese alarms vir daaglikse verjaarsdag-SMS-herinnerings en geskeduleerde databasis-afsettings. Dit verseker dat hulle op die regte tyd plaasvind, selfs wanneer die toestel ledig is.</string>

    <string name="rationale_notification_listener_title">Kennisgewingtoegang</string>
    <string name="rationale_notification_listener_message">WinkerkReader benodig kennisgewingtoegang om VoIP-oproepe (WhatsApp, Skype, ens.) op te spoor. Dit maak dit moontlik om hierdie oproepe te log. Die app lees slegs oproepverwante kennisgewings en stoor geen ander kennisgewingdata nie.</string>

    <string name="rationale_all_permissions_title">Toestemmings Benodig</string>
    <string name="rationale_all_permissions_message">WinkerkReader benodig verskeie toestemmings om volle funksionaliteit te bied. Gee asseblief die volgende toestemmings om voort te gaan.</string>
    <string name="rationale_generic_title">Toestemming Benodig</string>
    <string name="rationale_generic_message">Om hierdie funksie te gebruik, benodig WinkerkReader die volgende toestemming: %1$s</string>
