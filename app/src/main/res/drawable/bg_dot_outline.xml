<?xml version="1.0" encoding="utf-8"?>
<!--
    Deselected counterpart to @drawable/bg_badge_red.
    Used by ReminderPreviewAdapter for template reminder rows the user
    has toggled off — a hollow circle instead of the solid pink dot.

    NB: colorError is the M3 semantic red/pink tone. If bg_badge_red.xml
    uses a hardcoded hex instead of ?attr/colorError, swap the stroke
    color below to match it exactly so the two states read as the same hue.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="?attr/colorError" />
</shape>